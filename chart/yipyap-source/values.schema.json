{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "yipyap-source values",
  "type": "object",
  "additionalProperties": true,
  "required": ["namespace", "images", "controller", "webhook", "serviceAccounts"],
  "properties": {
    "namespace": {
      "type": "object",
      "additionalProperties": false,
      "required": ["create", "name"],
      "properties": {
        "create": { "type": "boolean" },
        "name":   { "type": "string", "minLength": 1 }
      }
    },
    "images": {
      "type": "object",
      "required": ["controller", "webhook", "adapter"],
      "properties": {
        "controller": { "$ref": "#/definitions/image" },
        "webhook":    { "$ref": "#/definitions/image" },
        "adapter":    { "$ref": "#/definitions/image" }
      }
    },
    "controller": {
      "type": "object",
      "required": ["replicas"],
      "properties": {
        "replicas": { "type": "integer", "minimum": 0 },
        "scopedNamespaces": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 63,
            "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?$"
          }
        },
        "resources": { "type": "object" },
        "nodeSelector": { "type": "object" },
        "tolerations": { "type": "array" },
        "affinity": { "type": "object" }
      }
    },
    "webhook": {
      "type": "object",
      "required": ["replicas", "failurePolicy", "port", "allowedBaseURLHosts"],
      "properties": {
        "replicas": { "type": "integer", "minimum": 0 },
        "failurePolicy": { "type": "string", "enum": ["Fail", "Ignore"] },
        "port": { "type": "integer", "minimum": 1, "maximum": 65535 },
        "allowedBaseURLHosts": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "pattern": "^((\\*\\.)?[A-Za-z0-9]([A-Za-z0-9.-]*[A-Za-z0-9])?|\\[[0-9A-Fa-f:.]+\\])(:[0-9]{1,5})?$"
          }
        },
        "resources": { "type": "object" },
        "nodeSelector": { "type": "object" },
        "tolerations": { "type": "array" },
        "affinity": { "type": "object" }
      }
    },
    "metrics": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" },
        "port": { "type": "integer", "minimum": 1, "maximum": 65535 }
      }
    },
    "serviceAccounts": {
      "type": "object",
      "required": ["controller", "webhook"],
      "properties": {
        "controller": { "$ref": "#/definitions/sa" },
        "webhook":    { "$ref": "#/definitions/sa" }
      }
    },
    "logging": { "type": "object" },
    "priorityClassName": { "type": "string" },
    "installCRD": { "type": "boolean" },
    "networkPolicy": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": { "type": "boolean" },
        "apiServerCIDRs": {
          "type": "array",
          "items": { "$ref": "#/definitions/cidr" },
          "uniqueItems": true
        },
        "apiServerPorts": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "integer", "minimum": 1, "maximum": 65535 },
          "uniqueItems": true
        },
        "webhookIngressCIDRs": {
          "type": "array",
          "items": { "$ref": "#/definitions/cidr" },
          "uniqueItems": true
        },
        "cilium": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "useEntities": { "type": "boolean" }
          }
        }
      }
    }
  },
  "definitions": {
    "cidr": {
      "type": "string",
      "pattern": "^([0-9]{1,3}(\\.[0-9]{1,3}){3}/([0-9]|[12][0-9]|3[0-2])|[0-9a-fA-F:]*:[0-9a-fA-F:.]*/([0-9]|[1-9][0-9]|1[01][0-9]|12[0-8]))$"
    },
    "image": {
      "type": "object",
      "required": ["repository"],
      "properties": {
        "repository": { "type": "string", "minLength": 1 },
        "tag": { "type": "string" },
        "digest": { "type": "string", "pattern": "^(sha256:[a-f0-9]{64})?$" },
        "pullPolicy": { "type": "string", "enum": ["Always", "IfNotPresent", "Never", ""] }
      }
    },
    "sa": {
      "type": "object",
      "required": ["name", "create"],
      "properties": {
        "name":   { "type": "string", "minLength": 1 },
        "create": { "type": "boolean" }
      }
    }
  }
}
